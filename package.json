{
  "name": "zmk-agency",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "build:no-prerender": "vite build",
    "_comment:build:vercel": "Prerendering needs Puppeteer's Chromium, which can fail to download on a CI image. Never let that take the whole deploy down — the site still works as an SPA without it, so the prerender step is allowed to fail loudly and continue.",
    "build:vercel": "vite build && (node scripts/prerender.mjs || echo '::warning:: prerender skipped — deploying SPA shell only')",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^12.8.0",
    "framer-motion": "^12.29.2",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.13.0",
    "react-use": "^17.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "puppeteer": "^24.37.3",
    "vite": "^7.2.4"
  }
}